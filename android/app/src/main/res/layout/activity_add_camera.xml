<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0E18"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/add_camera_close"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="Close"
                android:padding="10dp"
                android:src="@drawable/ic_rl_close_24"
                android:tint="@color/white" />

            <TextView
                android:id="@+id/add_camera_page_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Add Camera"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="@color/white" />

            <ImageButton
                android:id="@+id/add_camera_flash"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="Flash"
                android:padding="10dp"
                android:src="@drawable/ic_rl_flash_off_24"
                android:tint="@color/white" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="72dp"
            android:layout_marginBottom="160dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="#151020">

            <androidx.camera.view.PreviewView
                android:id="@+id/add_camera_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="#660A0912" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="#660A0912" />

                    <View
                        android:layout_width="220dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_scan_window_cutout" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="#660A0912" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="#660A0912" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/add_camera_scan_box"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_scan_frame">

                <View
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="top|start"
                    android:background="@drawable/bg_scan_corner_tl" />

                <View
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_scan_corner_tr" />

                <View
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="bottom|start"
                    android:background="@drawable/bg_scan_corner_bl" />

                <View
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_scan_corner_br" />
            </FrameLayout>

            <View
                android:id="@+id/add_camera_scan_line"
                android:layout_width="220dp"
                android:layout_height="2dp"
                android:layout_gravity="center"
                android:background="#66C8BFFF" />

            <TextView
                android:id="@+id/add_camera_scan_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:gravity="center"
                android:paddingBottom="14dp"
                android:text="Align QR code from camera within the frame"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/white" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_sheet_top"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/add_camera_sheet_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scan the QR code on your camera device or its packaging"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/auth_on_surface_variant" />

            <TextView
                android:id="@+id/add_camera_scan_btn"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_btn_tonal"
                android:gravity="center"
                android:text="Enter code manually"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="#E5DFF9"
                android:drawableStart="@drawable/ic_rl_edit_24"
                android:drawableTint="#E5DFF9"
                android:drawablePadding="8dp" />

            <TextView
                android:id="@+id/add_camera_nearby_btn"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_btn_outline"
                android:gravity="center"
                android:text="Search nearby devices"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="@color/auth_primary"
                android:drawableStart="@drawable/ic_rl_wifi_find_24"
                android:drawableTint="@color/auth_primary"
                android:drawablePadding="8dp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
