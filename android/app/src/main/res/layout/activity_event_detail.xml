<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_bg"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1C1728">

        <LinearLayout
            android:id="@+id/event_detail_top_bar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/event_detail_back"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_live_control"
                android:contentDescription="Back"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back_24"
                android:tint="@color/white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/event_detail_page_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Event Detail"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/event_detail_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Front Door"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="#DDFFFFFF"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <com.reallive.player.PlayerSurfaceView
            android:id="@+id/event_detail_player_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="H,16:9"
            app:layout_constraintTop_toBottomOf="@id/event_detail_top_bar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <View
            android:id="@+id/event_detail_night_overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#2A1A3366"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@id/event_detail_player_view"
            app:layout_constraintBottom_toBottomOf="@id/event_detail_player_view"
            app:layout_constraintStart_toStartOf="@id/event_detail_player_view"
            app:layout_constraintEnd_toEndOf="@id/event_detail_player_view" />

        <TextView
            android:id="@+id/event_detail_watermark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="8dp"
            android:background="#66000000"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:text="CAM"
            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
            android:textColor="@color/white"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@id/event_detail_player_view"
            app:layout_constraintStart_toStartOf="@id/event_detail_player_view" />

        <ImageView
            android:id="@+id/event_detail_placeholder_icon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/ic_rl_person_24"
            android:tint="#33FFFFFF"
            app:layout_constraintTop_toTopOf="@id/event_detail_player_view"
            app:layout_constraintBottom_toBottomOf="@id/event_detail_player_view"
            app:layout_constraintStart_toStartOf="@id/event_detail_player_view"
            app:layout_constraintEnd_toEndOf="@id/event_detail_player_view" />

        <FrameLayout
            android:id="@+id/event_detail_play_overlay"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="#66000000"
            app:layout_constraintTop_toTopOf="@id/event_detail_player_view"
            app:layout_constraintBottom_toBottomOf="@id/event_detail_player_view"
            app:layout_constraintStart_toStartOf="@id/event_detail_player_view"
            app:layout_constraintEnd_toEndOf="@id/event_detail_player_view">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_rl_play_24"
                android:tint="@color/white" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:background="#99000000"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:text="1:15"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="@color/white"
            app:layout_constraintBottom_toBottomOf="@id/event_detail_player_view"
            app:layout_constraintEnd_toEndOf="@id/event_detail_player_view" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/event_detail_playback_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/event_detail_progress_current"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/event_detail_progress_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/event_detail_seekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1000"
            android:progress="0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/event_detail_rewind_10s"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/bg_live_control"
                android:contentDescription="Rewind 10s"
                android:padding="10dp"
                android:src="@drawable/ic_rl_rewind_24"
                android:tint="@color/white" />

            <ImageButton
                android:id="@+id/event_detail_play_pause"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_live_control"
                android:contentDescription="Play Pause"
                android:padding="12dp"
                android:src="@drawable/ic_rl_pause_24"
                android:tint="@color/white" />

            <ImageButton
                android:id="@+id/event_detail_forward_10s"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="24dp"
                android:background="@drawable/bg_live_control"
                android:contentDescription="Forward 10s"
                android:padding="10dp"
                android:src="@drawable/ic_rl_fast_forward_24"
                android:tint="@color/white" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/event_detail_badge_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#4B232A"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="Person Detected"
                    android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                    android:textColor="@color/rl_error" />

                <TextView
                    android:id="@+id/event_detail_badge_priority"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@color/rl_surface"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="High Priority"
                    android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <TextView
                android:id="@+id/event_detail_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/event_detail_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_rl_videocam_24"
                        android:tint="?attr/colorOnSurfaceVariant" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

            <TextView
                android:id="@+id/event_detail_camera_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Front Door"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/event_detail_camera_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Main Entrance · 1080p"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_rl_motion_sensor_active_24"
                        android:tint="?attr/colorOnSurfaceVariant" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/event_detail_zone_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Detection Zone"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/event_detail_zone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Zone A - Entrance Area"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_rl_analytics_24"
                        android:tint="?attr/colorOnSurfaceVariant" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/event_detail_confidence_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Confidence"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/event_detail_score"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_rl_cloud_done_24"
                        android:tint="?attr/colorOnSurfaceVariant" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/event_detail_storage_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Storage"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/event_detail_storage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Cloud saved · 8.2 MB"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/event_detail_download"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_primary"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Download Clip"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textColor="@color/auth_on_primary"
                    android:drawableStart="@drawable/ic_rl_cloud_download_24"
                    android:drawableTint="@color/auth_on_primary"
                    android:drawablePadding="6dp" />

                <TextView
                    android:id="@+id/event_detail_share"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_outline"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Share"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textColor="@color/auth_primary"
                    android:drawableStart="@drawable/ic_rl_share_24"
                    android:drawableTint="@color/auth_primary"
                    android:drawablePadding="6dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>
